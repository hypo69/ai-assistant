  "gitignore_rules": {
    "temp_and_cache": [
      "~*",
      "~$*",
      "*.tmp",
      "*.log",
      "__pycache__/",
      "*.pyc",
      ".pytest_cache/",
      ".DS_Store",
      "Thumbs.db",
      "ehthumbs.db",
      "Desktop.ini",
      "$RECYCLE.BIN/"
    ],
    "infrastructure": [
      ".workspace/",
      "faiss_indices/",
      "*.faiss",
      "*.db-wal",
      "*.db-shm"
    ],
    "assets": [
      "assets/"
    ],
    "binary_media": [
      "*.pdf",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.bmp",
      "*.webp",
      "*.tiff",
      "*.gif",
      "*.wav",
      "*.mp3",
      "*.ogg",
      "*.m4a",
      "*.flac",
      "*.aac",
      "*.mp4",
      "*.avi",
      "*.mkv",
      "*.mov",
      "*.webm",
      "*.wmv",
      "*.flv",
      "*.m4v",
      "*.3gp",
      "*.opus",
      "*.wma"
    ],
    "exceptions": [
      "!*.md",
      "!*.txt"
    ]
  },
